{
    "name": "jamesclark32/dev-audit",
    "description": "Quickly run a set of CLI commands and summarize their outcome",
    "keywords": [
        "jamesclark32",
        "laravel",
        "dev-audit"
    ],
    "homepage": "https://github.com/jamesclark32/dev-audit",
    "license": "MIT",
    "authors": [
        {
            "name": "James Clark",
            "email": "james@weno.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.19.0",
    },
    "require-dev": {
        "laravel/pint": "^v1.21.0",
        "nunomaduro/collision": "^v8.6.1",
        "larastan/larastan": "^v3.1.0",
        "orchestra/testbench": "^v9.0||^v10.0",
        "pestphp/pest": "^v3.7.4",
        "pestphp/pest-plugin-arch": "^v3.0.0",
        "pestphp/pest-plugin-laravel": "^v3.1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.1",
        "phpstan/phpstan-phpunit": "^2.0.1",
        "spatie/laravel-ray": "^1.40.0"
    },
    "autoload": {
        "psr-4": {
            "JamesClark32\\DevAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JamesClark32\\DevAudit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-dev-audit --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JamesClark32\\DevAudit\\DevAuditServiceProvider"
            ],
            "aliases": {
                "DevAudit": "JamesClark32\\DevAudit\\Facades\\DevAudit"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
